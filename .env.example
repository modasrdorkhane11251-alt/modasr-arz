# =============================================================================
#  MODASR ARZ - environment file.  Copy to .env, then:  chmod 600 .env
#  NEVER commit .env. The installer (install.sh) creates and fills it for you.
#  Public market-data APIs (TGJU, Nobitex, Binance ...) need NO key and are
#  intentionally hardcoded in source - they do not belong here.
# =============================================================================

# --- Telegram (REQUIRED) -----------------------------------------------------
# Token from @BotFather. Treat it like a password; /revoke it if it ever leaks.
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
# Your numeric Telegram ID (from @userinfobot). Only this user can use admin commands.
ADMIN_ID="123456789"
# Bot username without @ (cosmetic; auto-detected by the installer)
BOT_USERNAME="YourBotUsername"

# --- Web admin panel (REQUIRED) ----------------------------------------------
# Min 8 chars; the server REFUSES to start in production with a placeholder/weak value.
# Change later with:  modasr passwd
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
# Random key that signs login sessions (>= 32 chars). The installer generates it.
# Manual:  openssl rand -hex 32     Rotating it logs every admin out.
SESSION_SECRET=""
# Panel login lifetime in hours (1 - 720, default 24)
SESSION_TTL_HOURS="24"

# --- Network -----------------------------------------------------------------
PORT="3000"
# Public domain (no https://). With a domain the app listens on 127.0.0.1 only and
# Nginx is the single public entry point. Leave empty for IP:PORT access.
DOMAIN=""
# Optional: full public URL used for the default webhook address
APP_URL=""
# Optional override of the listen address (default: 127.0.0.1 with DOMAIN, else 0.0.0.0)
HOST=""

# --- Mini App tunnel (only used when DOMAIN is empty) --------------------------
# Quick Cloudflare tunnel downloaded on first start. Set true to never download/run it.
DISABLE_TUNNEL="false"
# Optional sha256 (hex) of the cloudflared binary to pin its integrity
CLOUDFLARED_SHA256=""
